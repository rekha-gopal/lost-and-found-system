# Copy this file to ".env" (same folder) and edit the values.
# Never commit .env or share it. It is blocked from web access by .htaccess.

# URL path of the project on your server (XAMPP default shown)
BASE_URL=/college-lost-found

DB_HOST=localhost
DB_NAME=college_lost_found
DB_USER=root
DB_PASS=

# Optional: server-side AI matching (leave blank to use the built-in matcher)
AI_API_KEY=
AI_API_URL=
AI_MODEL=
